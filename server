def fetch_and_predict(filter_type="all"):
    records = get_diseases()
    grouped = group_by_disease_and_week(records, filter_type=filter_type)
    
    warning_list = []
    if not grouped.empty:
        diseases = grouped['disease'].unique()
        for disease in diseases:
            weekly_counts = to_weekly_series(grouped, disease)
            counts_list = [int(c) for c in weekly_counts]
            
            slope, forecast_week, volatility = detect_trend(weekly_counts)
            forecast_month = int(forecast_week) * 4 if forecast_week > 0 else 0

            risk_level, risk_code = classify_risk(slope, weekly_counts)
            advisory = get_nursing_advisory(disease, risk_code, forecast_week, slope, volatility)

            warning_list.append({
                'disease': str(disease),
                'weekly_counts': counts_list,
                'trend_slope': round(float(slope), 2),
                'next_week_forecast': int(forecast_week),
                'next_month_forecast': int(forecast_month),
                'volatility': round(float(volatility), 2),
                'risk_level': str(risk_level),
                'risk_code': str(risk_code),
                'advisory': str(advisory),
            })

        warning_list.sort(key=lambda w: w['trend_slope'], reverse=True)

    return warning_list

def is_gibberish(text):
    text_clean = text.strip().lower()
    
    # 1. Kung masyadong maikli at puro consonants o paulit-ulit (tulad ng asd, qwe, zxc)
    gibberish_patterns = [
        r'^[asdfghjklqwertyuiopzxcvbnm]+$',  # puro letters na walang vowels
        r'^(.)\1{3,}$',                      # paulit-ulit na iisang letra (aaaa, zzzz)
        r'^(asdf|qwer|zxcv)+$',              # mga karaniwang keyboard mash
    ]
    
    for pattern in gibberish_patterns:
        if re.search(pattern, text_clean):
            return True
            
    # 2. Kung walang vowels at lampas 4 na letra (hal. "qweqweqwe")
    if len(text_clean) > 4 and not any(v in text_clean for v in 'aeiou'):
        return True
        
    return False



@app.route("/api/predict")
def api_predict():
    filter_type = request.args.get("filter", "all")
    warnings = fetch_and_predict(filter_type)
    return jsonify({
        "status": "success",
        "filter": filter_type,
        "count": len(warnings),
        "data": warnings
    })


@app.route('/api/chat', methods=['POST'])
def chat():
    data = request.json
    user_message = data.get('message', '')
    
    # Kunin ang live surveillance data ng ospital para i-feed bilang context kay Gemini AI
    warnings = fetch_and_predict("all")
    
    hospital_context = "Current Live ACE Medical Center - Tuguegarao (ACEMCT) Surveillance Data:\n"
    for w in warnings:
        hospital_context += f"- Disease: {w['disease']} | Risk: {w['risk_level']} | Next Week Forecast: {w['next_week_forecast']} cases | Next Month Forecast: {w['next_month_forecast']} cases | Advisory: {w['advisory']}\n"

    # Fallback kung sakaling hindi pa nailalagay ang API key
    if not client:
        return jsonify({
            "status": "success", 
            "reply": "⚠️ **API Key Missing:** Pakilagay muna ang iyong Google AI Studio API key sa `server.py` sa may `GEMINI_API_KEY` para gumana ang AI chatbot."
        })
    
    if is_gibberish(user_message):
        return jsonify({"status": "success", "reply": "I'm sorry, I cannot answer that."})

    try:
        # System instructions para mag-act siya bilang Nurse Assistant ng ACEMCT
        # Mahigpit na Guardrail Instruction para sa Hospital Surveillance lamang
        system_instruction = (
            "You are an expert Chief Nursing Surveillance Assistant at ACE Medical Center - Tuguegarao (ACEMCT). "
            "STRICT RULES:\n"
            "1. You ONLY answer questions related to hospital disease surveillance, patient admission forecasts, risk levels, outbreaks, ward protocols, nursing care plans, and clinical health data provided below.\n"
            "2. If the user types random keyboard smashes (e.g., 'asdasdasd', 'qweqwe'), gibberish, meaningless characters, or anything out of the topic of hospital operations, nursing, clinical medicine, or public health surveillance, you MUST reply with EXACTLY this phrase and nothing else: "
            "\"I'm sorry, I cannot answer that.\"\n\n"
            f"{hospital_context}"
        )

        # Paggamit sa Gemini 2.5 Flash (Libre at napakabilis para sa text generation)
        response = client.models.generate_content(
            model='gemini-3.6-flash',
            # model='gemini-3.8-flash',
            contents=user_message,
            config=types.GenerateContentConfig(
                system_instruction=system_instruction,
                temperature=0.3,
            ),
        )
        
        reply = response.text

    except Exception as e:
        reply = f"❌ Error communicating with Google Gemini AI: {str(e)}"

    return jsonify({"status": "success", "reply": reply})


@app.route("/api/export-report")
def export_report():
    filter_type = request.args.get("filter", "all")
    warnings = fetch_and_predict(filter_type)

    if not warnings:
        return "No data available to export.", 400

    export_data = []
    for item in warnings:
        export_data.append({
            "Disease / Condition": item['disease'],
            "Risk Classification": item['risk_level'],
            "Trend Slope": item['trend_slope'],
            "Next Week Forecast (Cases)": item['next_week_forecast'],
            "Next Month Forecast (Cases)": item['next_month_forecast'],
            "Volatility Score": item['volatility'],
            "Nursing & Resource Advisories": item['advisory'].replace("<strong>", "").replace("</strong>", "").replace("🚨", "").replace("⚠️", "").replace("✅", "")
        })

    df = pd.DataFrame(export_data)
    output = io.BytesIO()
    with pd.ExcelWriter(output, engine='openpyxl') as writer:
        df.to_excel(writer, index=False, sheet_name='ACEMCT Surveillance')
    output.seek(0)

    filename = f"ACEMCT_Nurse_Report_{filter_type}.xlsx"
    return send_file(
        output,
        mimetype='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        as_attachment=True,
        download_name=filename
    )


