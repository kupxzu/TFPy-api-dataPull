                if (item.risk_code === 'moderate') modRiskCount++;

                const badgeStyles = {
                    'high': 'bg-red-50 text-red-600 border-red-200',
                    'moderate': 'bg-amber-50 text-amber-700 border-amber-200',
                    'low': 'bg-blue-50 text-blue-700 border-blue-200',
                    'stable': 'bg-emerald-50 text-emerald-700 border-emerald-200'
                };
                const badgeClass = badgeStyles[item.risk_code] || 'bg-slate-100 text-slate-700 border-slate-200';

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/80 transition border-b border-slate-100";
                tr.innerHTML = `
                    <td class="py-4 px-6 font-bold text-slate-900">${item.disease}</td>
                    <td class="py-4 px-6">
                        <span class="px-3 py-1 text-xs font-bold rounded-full border ${badgeClass}">
                            ${item.risk_level}
                        </span>
                    </td>
                    <td class="py-4 px-6 font-mono font-bold text-slate-700">${item.trend_slope > 0 ? '+' : ''}${item.trend_slope.toFixed(2)}</td>
                    <td class="py-4 px-6 font-bold text-emerald-700 text-base">
                        <span class="text-xs text-slate-500 block font-normal">Next Week: ${item.next_week_forecast}</span>
                        Next Month: ${item.next_month_forecast}
                    </td>
                    <td class="py-4 px-6 text-xs text-slate-600 max-w-lg">
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 leading-relaxed shadow-xs">
                            ${item.advisory}
                        </div>
                    </td>
                `;
                tableBody.appendChild(tr);
            });

            document.getElementById('highRiskCount').innerText = highRiskCount;
            document.getElementById('modRiskCount').innerText = modRiskCount;
            document.getElementById('totalTrackedCount').innerText = data.length;

            updateChart(labels, monthForecastValues, weekForecastValues, currentChartType);
        }

        function updateChart(labels, monthValues, weekValues, chartType) {
            const ctx = document.getElementById('forecastChart').getContext('2d');
            if (forecastChartInstance) forecastChartInstance.destroy();

            forecastChartInstance = new Chart(ctx, {
                type: chartType,
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Next Month Forecast',
                            data: monthValues,
                            backgroundColor: chartType === 'bar' ? 'rgba(5, 150, 105, 0.75)' : 'rgba(5, 150, 105, 0.1)',
                            borderColor: 'rgba(5, 150, 105, 1)',
                            borderWidth: 2,
                            borderRadius: 6,
                            tension: 0.3,
                            fill: chartType === 'line'
                        },
                        {
                            label: 'Next Week Forecast',
                            data: weekValues,
                            backgroundColor: chartType === 'bar' ? 'rgba(220, 38, 38, 0.75)' : 'rgba(220, 38, 38, 0.1)',
                            borderColor: 'rgba(220, 38, 38, 1)',
                            borderWidth: 2,
                            borderRadius: 6,
                            tension: 0.3,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { 
                            display: true, 
                            position: 'top',
                            labels: { font: { family: 'sans-serif', weight: 'bold', size: 11 }, boxWidth: 12 }
                        } 
                    },
                    scales: {
                        y: { 
                            grid: { color: 'rgba(226, 232, 240, 1)' }, 
                            ticks: { color: '#64748b', font: { weight: 'bold' } } 
                        },
                        x: { 
                            grid: { display: false }, 
                            ticks: { color: '#64748b', font: { weight: 'bold' } } 
                        }
                    }
                }
            });
        }

        async function handleChatSubmit(event) {
            event.preventDefault();
            const inputField = document.getElementById('chatInput');
            const message = inputField.value.trim();
            if (!message) return;

            const chatMessages = document.getElementById('chatMessages');

            const userBubble = document.createElement('div');
            userBubble.className = "flex items-start gap-3 justify-end";
            userBubble.innerHTML = `
                <div class="bg-emerald-600 text-white p-4 rounded-2xl rounded-tr-none max-w-xl text-sm shadow-sm">
                    <p class="font-bold text-emerald-100 mb-1">Nurse-in-Charge</p>
                    ${escapeHtml(message)}
                </div>
                <div class="p-2.5 bg-emerald-700 text-white rounded-xl shadow-xs">
                    <i class="fa-solid fa-user-nurse"></i>
                </div>
            `;
            chatMessages.appendChild(userBubble);
            inputField.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;

            const typingBubble = document.createElement('div');
            typingBubble.id = "typingIndicator";
            typingBubble.className = "flex items-start gap-3";
            typingBubble.innerHTML = `
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-200">
                    <i class="fa-solid fa-hospital"></i>
                </div>
                <div class="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-none text-sm text-slate-500 shadow-sm">
                    <i class="fa-solid fa-circle-notch fa-spin text-emerald-600 mr-2"></i> Gemini AI is thinking...
                </div>
            `;
            chatMessages.appendChild(typingBubble);
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                const data = await response.json();
                
                document.getElementById('typingIndicator').remove();

                const aiBubble = document.createElement('div');
                aiBubble.className = "flex items-start gap-3";
                aiBubble.innerHTML = `
                    <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-xl border border-emerald-200">
                        <i class="fa-solid fa-hospital"></i>
                    </div>
                    <div class="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-none max-w-xl text-sm text-slate-700 shadow-sm">
                        <p class="font-bold text-emerald-700 mb-1">Gemini AI Assistant</p>
                        ${escapeHtml(data.reply).replace(/\\n/g, '<br>')}
                    </div>
                `;
                chatMessages.appendChild(aiBubble);
                chatMessages.scrollTop = chatMessages.scrollHeight;

            } catch (err) {
                console.error("Chat error:", err);
                document.getElementById('typingIndicator').remove();
            }
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        document.addEventListener('DOMContentLoaded', () => loadDashboardData('all'));
    </script>
</body>
</html>
    """)

if __name__ == "__main__":
